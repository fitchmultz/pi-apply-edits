{
  "name": "pi-apply-edits",
  "version": "1.1.0",
  "description": "Focused patch, replacement, write, and preview tools for Pi.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "extension",
    "apply-edits",
    "edit",
    "write",
    "atomic",
    "typescript"
  ],
  "files": [
    "extensions",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "LICENSE-codex"
  ],
  "pi": {
    "extensions": [
      "./extensions/apply-edits.ts"
    ]
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:jxa": "tsc --noEmit -p tsconfig.jxa.json",
    "pack:check": "npm pack --dry-run",
    "lint": "oxlint --deny-warnings .",
    "lint:agent": "oxlint --deny-warnings --format=agent .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "policy:check": "node scripts/check-policy.ts",
    "quality:probes": "node --test test/quality*.test.ts",
    "check": "node scripts/check.ts",
    "check:compat": "npm run check",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "npm@12.2.0",
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/eslint": "9.6.1",
    "@types/node": "24.19.1",
    "oxc-parser": "0.156.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typebox": "1.3.34",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "author": "Mitch Fultz (https://github.com/fitchmultz)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitchmultz/pi-apply-edits.git"
  },
  "bugs": {
    "url": "https://github.com/fitchmultz/pi-apply-edits/issues"
  },
  "homepage": "https://github.com/fitchmultz/pi-apply-edits#readme",
  "dependencies": {
    "diff": "9.0.0"
  }
}
